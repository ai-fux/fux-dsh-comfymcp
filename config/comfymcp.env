# comfy-mcp 对接运行配置示例（复制/按需修改后随进程环境注入）
# 优先级：环境变量 > DSH 行配置 > 覆盖文件（DSH_HOME/comfymcp/config-overlay.json）> 默认

# comfy-mcp 服务端点（Streamable HTTP）
COMFY_MCP_ENDPOINT=http://127.0.0.1:18800/mcp

# MCP 宿主入口（DSH 插件 spawn 的本地 stdio 桥）
DSH_COMFYMCP_HOST_ENTRY=F:\AgentWorkplace\dsh\dsh-13188-comfymcp\projects\dsh-comfymcp\mcp\bin\fux-comfymcp-host.mjs

# comfy-mcp 参考服务端自身（一般用常驻服务方式启动）
# COMFY_MCP_SERVER_PORT=18800
# COMFY_MCP_SERVER_HOST=127.0.0.1
# 真实 ComfyUI 后端（stdio MCP 服务器；Node 程序，仅经 HTTP 访问 ComfyUI :8000，无 Python 依赖）：
# COMFY_MCP_BACKEND=stdio
# COMFY_MCP_BACKEND_CMD=node
# COMFY_MCP_BACKEND_ARGS=F:\AgentWorkplace\dsh\dsh-1-comfy-p\projects\dsh-comfyui\mcp\bin\fux-comfyui-mcp.mjs
# 无 ComfyUI 时用内置 mock 后端做联调（mock 的 node_search 同样提供 UnloadAllModels）：
# COMFY_MCP_BACKEND=mock
# Python 侧要求：ComfyUI 运行于 :8000（.venv 自备）+ custom_nodes 内装 comfyui-unload-model
# （无 pip 依赖）；验证见 README「Python 侧依赖」一节。
