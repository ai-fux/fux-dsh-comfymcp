{
  "name": "@ai-fux/fux-dsh-comfymcp",
  "version": "0.6.1",
  "type": "module",
  "description": "DSH 插件：对接 comfy-mcp 服务（自然语言设计可运行工作流、定制表单、运行与成果物回显）+ 多模态创作台（直连魔搭/HuggingFace/Ollama/vLLM/A1111 文生图与图生图）。",
  "license": "MIT",
  "author": "easymor2024-ychen",
  "homepage": "https://github.com/ai-fux/fux-dsh-comfymcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-fux/fux-dsh-comfymcp.git"
  },
  "bugs": {
    "url": "https://github.com/ai-fux/fux-dsh-comfymcp/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "comfyui",
    "comfy-mcp",
    "mcp",
    "workflow",
    "agent",
    "text-to-image",
    "image-generation",
    "modelscope",
    "huggingface"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "locale/*.json",
    "cordis.patch.yml",
    "vendor/**",
    "INSTALL.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
