{
  "name": "@fux-mcp/comfy-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FUX 通用客户端插件：对接 comfy-mcp 服务（MCP Streamable HTTP）——连接、工具目录、工具调用与成果物取回。",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fux/protocol": "workspace:*",
    "@fux/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "fux",
    "mcp",
    "comfyui",
    "streamable-http"
  ]
}
